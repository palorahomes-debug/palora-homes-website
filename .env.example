# ==========================================================
# PALORA HOMES - ENVIRONMENT VARIABLES TEMPLATE
# Add these in Netlify: Site configuration -> Environment variables
# ==========================================================

# 1. Supabase Project URL
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Service Role Secret Key (Keep Private - Server Only!)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# 3. Supabase Anon Public Key
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon public
SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# 4. Store Admin Dashboard PIN
ADMIN_PIN=palora2026
